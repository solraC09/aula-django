# Copie este arquivo para .env e preencha com os seus dados.
# O .env NÃO vai para o Git (está no .gitignore); o .env.example vai.

SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Apague/comente DB_NAME para voltar ao SQLite.
DB_NAME=biblioteca
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=127.0.0.1
DB_PORT=5432
